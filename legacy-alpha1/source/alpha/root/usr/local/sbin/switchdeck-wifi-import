#!/usr/bin/python3
"""Import optional two-line UTF-8 wifi.txt. Never execute or log credentials."""
from pathlib import Path
import hashlib, subprocess
source=Path('/run/initramfs/mounts/boot/switchroot/switchdeck-alpha/wifi.txt')
marker=Path('/var/lib/switchdeck/wifi-import.sha256')
if not source.is_file():raise SystemExit(0)
raw=source.read_bytes(); digest=hashlib.sha256(raw).hexdigest()
if marker.exists() and marker.read_text().strip()==digest:raise SystemExit(0)
lines=raw.decode('utf-8-sig').splitlines()
if not lines or not 1<=len(lines[0].encode())<=32 or len(lines)>2:raise SystemExit('Invalid wifi.txt: SSID and optional password on two lines')
ssid=lines[0]; psk=lines[1] if len(lines)>1 else ''
if psk and not (8<=len(psk)<=63 or (len(psk)==64 and all(c in '0123456789abcdefABCDEF' for c in psk))):raise SystemExit('Invalid Wi-Fi password length')
name='switchdeck-wifi-'+digest[:12]
def run(args):subprocess.run(['nmcli','--wait','20']+args,check=True,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
run(['connection','add','type','wifi','ifname','*','con-name',name,'ssid',ssid])
if psk:run(['connection','modify',name,'wifi-sec.key-mgmt','wpa-psk','wifi-sec.psk',psk])
run(['connection','modify',name,'connection.autoconnect','yes'])
marker.parent.mkdir(parents=True,exist_ok=True);marker.write_text(digest+'\n');marker.chmod(0o600)
subprocess.run(['nmcli','--wait','20','connection','up',name],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
print('Wi-Fi profile imported; remove wifi.txt from SD after successful connection.')
